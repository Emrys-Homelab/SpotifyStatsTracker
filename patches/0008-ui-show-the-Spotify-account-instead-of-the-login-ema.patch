From f9188f56455fbc4c8cabd251c052a4dd6dd35b06 Mon Sep 17 00:00:00 2001
From: homelab-admin <homelab-admin@homelab>
Date: Sun, 22 Nov 2026 19:20:36 +0000
Subject: [PATCH 08/10] ui: show the Spotify account instead of the login email

The login identity is now "who may use the app"; the Spotify account is
"whose listening is tracked", and in an SSO setup that is the one the user
cares about. A request-scoped context processor exposes the observed identity,
and the nav trigger, the account page and the dashboard greeting all lead with
it, labelled "Spotify account". The proxy's email stays visible as secondary
context ("Signed in as") and is the fallback until a profile has been read.
---
 dashboard/context_processors.py  | 16 ++++++++++++
 static/css/style.css             | 45 ++++++++++++++++++++++++++++++++
 templates/_profile_base.html     | 15 ++++++++++-
 templates/layout.html            | 14 +++++++++-
 templates/tracks.html            | 14 ++++++++++
 tests/test_context_processors.py |  4 ++-
 tests/test_dashboard_cards.py    | 27 +++++++++++++++++++
 tests/test_profile_split.py      | 39 +++++++++++++++++++++++++++
 8 files changed, 171 insertions(+), 3 deletions(-)

diff --git a/dashboard/context_processors.py b/dashboard/context_processors.py
index 6310825..dc911c1 100644
--- a/dashboard/context_processors.py
+++ b/dashboard/context_processors.py
@@ -98,6 +98,22 @@ def register(app, dashboard) -> None:
         return {"isAdmin": _memoized(
             "isAdmin", lambda: dashboard.repo.isAdmin(username) if username else False)}
 
+    @app.context_processor
+    def _injectSpotifyIdentity():
+        """The CONNECTED SPOTIFY ACCOUNT, separate from the login identity.
+
+        Behind the trusted proxy, session["email"] is who the proxy let in; this
+        is whose listening the stored cookies read. The UI names this one, and
+        templates fall back to the login identity only while no profile has been
+        observed yet (every pre-upgrade row, and a profile fetch that failed).
+
+        One query per request, memoized on g like the other per-user reads.
+        """
+        username = session.get("username")
+        return {"spotify_identity": _memoized(
+            "spotifyIdentity",
+            lambda: dashboard.repo.getSpotifyIdentity(username) if username else None)}
+
     @app.context_processor
     def _injectRegistrationStatus():
         # Lets login.html hide its "Create an account" link when the
